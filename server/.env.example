# --- LLM (Groq free tier: https://console.groq.com/keys) ---
GROQ_API_KEY=
LLM_MODEL=openai/gpt-oss-120b

# --- Vector store ---
# "weaviate" (Weaviate Cloud sandbox) or "memory" (in-process, data lost on restart)
VECTOR_STORE=weaviate
# Free sandbox: https://console.weaviate.cloud -> Create cluster -> Sandbox
WEAVIATE_URL=
WEAVIATE_API_KEY=
WEAVIATE_COLLECTION=DocumentChunk

# --- Embeddings (local, runs on CPU, multilingual incl. Greek) ---
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_QUERY_PREFIX="query: "
EMBEDDING_DOCUMENT_PREFIX="passage: "

# --- Chunking & retrieval ---
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
TOP_K=5
MIN_RELEVANCE_SCORE=0.0
MAX_UPLOAD_MB=20

# --- HTTP ---
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
