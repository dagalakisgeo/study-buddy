{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Server: FastAPI (debug)",
      "type": "debugpy",
      "request": "launch",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "module": "uvicorn",
      "args": ["study_buddy.main:create_app", "--factory", "--port", "8000", "--log-level", "debug"],
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "jinja": true,
      "justMyCode": true,
      "serverReadyAction": {
        "pattern": "Uvicorn running on (https?://\\S+)",
        "uriFormat": "%s/docs",
        "action": "openExternally"
      }
    },
    {
      "name": "Server: pytest (debug)",
      "type": "debugpy",
      "request": "launch",
      "python": "${workspaceFolder}/.venv/Scripts/python.exe",
      "module": "pytest",
      "args": ["-x", "-v"],
      "cwd": "${workspaceFolder}",
      "justMyCode": false
    }
  ]
}
