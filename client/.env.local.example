# Copy to .env.local to override the defaults (restart `npm run dev` after changes).

# Base URL of the Study Buddy FastAPI server (no trailing slash).
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# Client-side upload limit in MB; keep in sync with MAX_UPLOAD_MB in server/.env.
NEXT_PUBLIC_MAX_UPLOAD_MB=20
